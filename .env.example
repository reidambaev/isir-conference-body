# ISIR Member Verification API
VITE_ISIR_API_ENDPOINT=/api/check-member
VITE_ISIR_API_KEY=your-api-key-here

# Worker-only: upstream WordPress member check (default: theisir.org admin-ajax.php).
# ISIR_MEMBER_CHECK_ENDPOINT=https://theisir.org/wp-admin/admin-ajax.php
# ISIR_API_KEY=same-as-WP-option-isir_member_api_key-if-set

# Stripe Payment Processing
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
