{
  "name": "isir-conference-2026",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // D1 Database binding
  "d1_databases": [
    {
      "binding": "ISIR_DB",
      "database_name": "isir-registrations",
      "database_id": "1acb1f5b-4274-4b2c-abb4-71b6669bd9a9"
    }
  ],
  // R2 Storage binding for trainee verification letters
  "r2_buckets": [
    {
      "binding": "SPEAKER_PHOTOS_BUCKET",
      "bucket_name": "isir-speaker-photos"
    },
    {
      "binding": "TRAINEE_LETTERS_BUCKET",
      "bucket_name": "isir-trainee-letters"
    }
  ],
  // Enable logging/observability
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  // Git/wrangler deploys replace dashboard plaintext vars with this file.
  // keep_vars preserves dashboard-only vars that are not listed here.
  // Secrets (encrypted) are never deleted by a deploy.
  "keep_vars": true,
  "vars": {
    "REGISTRATION_FLAT_DISCOUNT_AMOUNT_USD": "250"
  },
  // Separate Worker name + URL; inherits D1/R2/bindings from root unless overridden here.
  // vars are not inherited by named environments and must be repeated.
  "env": {
    "preview": {
      "name": "isir-conference-2026-preview",
      "vars": {
        "REGISTRATION_FLAT_DISCOUNT_AMOUNT_USD": "250"
      }
    }
  }
}